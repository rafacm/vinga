# This file is mounted only into the Collector. Copy it to .env in this
# directory and replace each value. Do not put these names in the root
# .env, which belongs to the vinga container.
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
